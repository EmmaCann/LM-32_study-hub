{
  "name": "lm32-study-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-cpp-runtime.mjs",
    "prebuild": "node scripts/prepare-cpp-runtime.mjs",
    "cpp:verify": "tsx scripts/verify-cpp.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "tsx scripts/content.ts validate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "content": "tsx scripts/content.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@yowasp/clang": "22.0.0-git20542-10",
    "katex": "0.19.1",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "katex": "0.19.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
